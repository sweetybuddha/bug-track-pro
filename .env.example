# Copy this file to .env for local development. Never commit real secrets.

# Optional server-side LLM integration
BUGTRACK_LLM_API_KEY=
BUGTRACK_LLM_BASE_URL=https://api.openai.com/v1
BUGTRACK_LLM_MODEL=gpt-4o-mini

# SMTP email delivery
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-smtp-username
SMTP_PASSWORD=your-smtp-password
SMTP_FROM_EMAIL=no-reply@example.com

EMAIL_VERIFICATION_EXPIRY_MINUTES=10
EMAIL_VERIFICATION_SECRET=replace-with-a-long-random-secret
SESSION_SECRET=replace-with-another-long-random-secret
PASSWORD_RESET_EXPIRY_MINUTES=20
APP_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Frontend API URL (leave empty for same-origin / proxy, or set to your backend deployment URL e.g. https://your-backend.vercel.app)
VITE_API_URL=

# Supabase database configuration & migration
SUPABASE_URL=https://YOUR_PROJECT_ID.supabase.co
SUPABASE_SECRET_KEY=YOUR_SERVER_SIDE_SECRET_KEY
