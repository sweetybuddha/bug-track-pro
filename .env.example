# BugTrack Pro — Environment Configuration Template
# Copy this file to .env for local development or set these variables in your deployment dashboard (e.g. Render).
# NEVER commit .env or real credentials to GitHub.

# Server Port & Environment
PORT=3000
NODE_ENV=development

# Application & Frontend URLs
# For local development: http://localhost:5173
# For Render deployment: https://your-service.onrender.com
APP_URL=http://localhost:5173
FRONTEND_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000,http://127.0.0.1:3000

# Frontend API URL (Vite client-side)
# - Leave empty for local development (Vite automatically proxies /api to http://127.0.0.1:3000)
# - Set to your deployed Render URL (e.g. https://your-service.onrender.com) if deployed separately
VITE_API_URL=

# Supabase Database Configuration
SUPABASE_URL=https://YOUR_PROJECT_ID.supabase.co
SUPABASE_SECRET_KEY=YOUR_AUTHORIZED_SERVER_SECRET_KEY

# SMTP Email Delivery (Gmail, SendGrid, Amazon SES, Mailgun, etc.)
# For Gmail: Use smtp.gmail.com, port 587, your full Gmail address, and a 16-character Google App Password
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_FROM_EMAIL=your-email@gmail.com

# Auto-verify fallback (set to true to auto-verify users during registration if SMTP is unconfigured or blocked)
AUTO_VERIFY_IF_NO_SMTP=true

# Security & Expiration Settings
EMAIL_VERIFICATION_EXPIRY_MINUTES=10
PASSWORD_RESET_EXPIRY_MINUTES=20
EMAIL_VERIFICATION_SECRET=replace-with-a-random-64-character-secret
SESSION_SECRET=replace-with-a-random-64-character-secret

# Python Analyzer Service (defaults to http://127.0.0.1:5000)
ANALYZER_URL=http://127.0.0.1:5000

# Optional Server-side LLM Integration
BUGTRACK_LLM_API_KEY=
BUGTRACK_LLM_BASE_URL=https://api.openai.com/v1
BUGTRACK_LLM_MODEL=gpt-4o-mini
